[
  // Zed keymap shared by hq and macOS, layered on base_keymap "VSCode". It follows the VSCode (emacs-mcx) setup; edit this file directly.
  // base_keymap "VSCode" に重ねる Zed のキーマップ（hq と macOS で共通）。VSCode（emacs-mcx）の設定に合わせている。このファイルを直接編集する。
  //
  // When bindings in two blocks match at the same depth, the later block wins, so keep the block order.
  // 同じ深さで重なった割り当ては、後ろのブロックが勝つ。ブロックの順番を崩さない。
  //
  // On hq, Hyprland takes ALT keys such as alt-; alt-l and alt-p first, and xremap turns C-h into Backspace.
  // hq では、alt-;・alt-l・alt-p などの ALT キーを Hyprland が先に使い、C-h は xremap が Backspace に変える。
  {
    // Everywhere / どこでも
    "bindings": {
      "ctrl-g": "menu::Cancel",
      "ctrl-q": "project_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      // Leave C-b, C-n and C-p to movement instead of the VSCode defaults. / C-b・C-n・C-p は VSCode の既定ではなく移動に使う。
      "ctrl-b": null,
      "ctrl-n": null,
      "ctrl-p": null,
      // Keys VSCode unbinds or uses only inside editors; they do nothing elsewhere. / VSCode で外しているか、エディターの中だけで使うキー。それ以外の場所では何もしない。
      "ctrl-s": null,
      "ctrl-w": null,
      "ctrl-j": null,
      "ctrl-e": null,
      "ctrl-r": null,
      "ctrl-o": null,
      "ctrl-0": null,
      "ctrl--": null,

      // Files and buffers / ファイルとバッファー
      "ctrl-x ctrl-f": "file_finder::Toggle",
      "ctrl-x ctrl-b": "file_finder::Toggle",
      "ctrl-x b": "file_finder::Toggle",
      "ctrl-x n": "pane::ActivateNextItem",
      "ctrl-x ctrl-p": "pane::GoBack",
      "ctrl-x ctrl-o": "projects::OpenRecent",
      "ctrl-x ctrl-s": "workspace::Save",
      "ctrl-x ctrl-w": "workspace::SaveAs",
      "ctrl-x s": "workspace::SaveAll",
      "ctrl-x k": "pane::CloseActiveItem",
      "ctrl-x c": "pane::CloseActiveItem",
      "ctrl-x ctrl-c": "pane::CloseAllItems",

      // Panes and windows / ペインとウィンドウ
      "ctrl-x 0": "pane::CloseActiveItem",
      "ctrl-x 1": "pane::CloseOtherItems",
      "ctrl-x 2": "pane::SplitDown",
      "ctrl-x 3": "pane::SplitRight",
      "ctrl-x o": "workspace::ActivateNextPane",
      "ctrl-x 5 2": "workspace::NewWindow",
      "ctrl-x 5 0": "workspace::CloseWindow",
      "alt-shift-n": "workspace::NewWindow",

      // Commands and panels / コマンドとパネル
      "alt-x": "command_palette::Toggle",
      "ctrl-[": "editor::ToggleFocus",
      "ctrl-=": "workspace::ToggleBottomDock",
      // The key right of "-" on the JIS layout, which VSCode binds as ctrl+[Equal]. / JIS 配列で - の右のキー。VSCode では ctrl+[Equal] として割り当てている。
      "ctrl-^": "workspace::ToggleBottomDock",
      "ctrl-\\": "zed::OpenKeymap",
      "ctrl-shift-b": "git::Blame",

      // Agent / エージェント
      "ctrl-i": "agent::Chat",
      "ctrl-]": "agent::Chat",
      "ctrl-enter": "agent::OpenAddContextMenu",
      "ctrl-shift-n": "agent::NewThread",
      "ctrl-tab": "agent::CycleFavoriteModels"
    }
  },
  {
    // Every editor, including single-line inputs / すべてのエディター（1 行の入力欄を含む）
    "context": "Editor",
    "bindings": {
      // Movement / 移動
      "ctrl-f": "editor::MoveRight",
      "ctrl-b": "editor::MoveLeft",
      "ctrl-n": "editor::MoveDown",
      "ctrl-p": "editor::MoveUp",
      "ctrl-a": ["editor::MoveToBeginningOfLine", { "stop_at_soft_wraps": false }],
      "ctrl-e": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": false }],
      "home": ["editor::MoveToBeginningOfLine", { "stop_at_soft_wraps": false }],
      "end": ["editor::MoveToEndOfLine", { "stop_at_soft_wraps": false }],
      "alt-m": ["editor::MoveToBeginningOfLine", { "stop_at_soft_wraps": false, "stop_at_indent": true }],
      "alt-f": "editor::MoveToNextWordEnd",
      "alt-b": "editor::MoveToPreviousWordStart",
      "alt-right": "editor::MoveToNextWordEnd",
      "alt-left": "editor::MoveToPreviousWordStart",
      "ctrl-v": "editor::MovePageDown",
      "alt-v": "editor::MovePageUp",
      "alt-<": "editor::MoveToBeginning",
      "alt->": "editor::MoveToEnd",
      "ctrl-x [": "editor::MoveToBeginning",
      "ctrl-x ]": "editor::MoveToEnd",
      "alt-{": "editor::MoveToStartOfParagraph",
      "alt-}": "editor::MoveToEndOfParagraph",
      "ctrl-up": "editor::MoveToStartOfParagraph",
      "ctrl-down": "editor::MoveToEndOfParagraph",
      "alt-n": "editor::MoveToStartOfNextExcerpt",
      "ctrl-l": "editor::ScrollCursorCenterTopBottom",
      "alt-g g": "go_to_line::Toggle",
      "alt-g alt-g": "go_to_line::Toggle",
      "shift-home": ["editor::SelectToBeginningOfLine", { "stop_at_soft_wraps": false }],
      "shift-end": ["editor::SelectToEndOfLine", { "stop_at_soft_wraps": false }],

      // Mark / マーク
      "ctrl-space": "editor::SetMark",
      "ctrl-@": "editor::SetMark",
      "ctrl-x ctrl-x": "editor::SwapSelectionEnds",
      "ctrl-x h": "editor::SelectAll",
      "ctrl-g": "editor::Cancel",

      // Cut, copy and paste all use the system clipboard, as in VSCode. Unlike emacs-mcx, repeated C-k does not join the cut text.
      // 切り取り・コピー・貼り付けは、VSCode と同じくすべてクリップボードを使う。emacs-mcx と違い、C-k を続けて押しても切り取った内容はつながらない。
      "ctrl-k": "editor::CutToEndOfLine",
      "ctrl-w": "editor::Cut",
      "alt-w": "editor::Copy",
      "ctrl-y": "editor::Paste",
      // Free C-x for the C-x prefix. / C-x を接頭キーとして使う。
      "ctrl-x": null,

      // Deleting / 削除
      "ctrl-d": "editor::Delete",
      // C-h (on macOS; xremap handles it on hq) and C-Backspace delete one character, as in VSCode. / C-h（macOS 用。hq では xremap が処理する）と C-Backspace は、VSCode と同じく 1 文字削除にする。
      "ctrl-h": "editor::Backspace",
      "ctrl-backspace": "editor::Backspace",
      "alt-d": ["editor::DeleteToNextWordEnd", { "ignore_newlines": false, "ignore_brackets": false }],
      "alt-backspace": "editor::DeleteToPreviousWordStart",
      "alt-delete": "editor::DeleteToPreviousWordStart",
      "ctrl-0": "editor::DeleteToPreviousSubwordStart",
      "ctrl-9": "editor::DeleteToNextSubwordEnd",

      // Undo / 元に戻す
      "ctrl-/": "editor::Undo",
      "ctrl-_": "editor::Undo",
      "ctrl-x u": "editor::Undo",

      // Search and replace / 検索と置換
      "ctrl-s": "buffer_search::Deploy",
      "ctrl-r": "buffer_search::Deploy",
      "ctrl-o": "buffer_search::DeployReplace",

      // Editing / 編集
      "ctrl-t": "editor::Transpose",
      "alt-^": "editor::JoinLines",
      "alt-q": "editor::Rewrap",
      "alt-u": "editor::ConvertToUpperCase",
      "alt-c": "editor::ConvertToUpperCamelCase",
      // C-x C-l as in Emacs, because Hyprland takes alt-l. / Hyprland が alt-l を使うので、Emacs と同じ C-x C-l にする。
      "ctrl-x ctrl-l": "editor::ConvertToLowerCase",
      "ctrl-x ctrl-;": "editor::ToggleComments",

      // Code navigation / コードの移動
      "alt-.": "editor::GoToDefinition",
      "alt-,": "pane::GoBack",
      "alt-?": "editor::FindAllReferences",
      "shift-f12": "editor::FindAllReferences",

      // Focus the last buffer, as in VSCode, instead of Zed's outdent. / Zed の既定のインデント戻しではなく、VSCode と同じく直近のバッファーにフォーカスする。
      "ctrl-[": "editor::ToggleFocus",

      // Zed defaults that VSCode unbinds: rename, undo selection, delete word and paste. / VSCode で外している Zed の既定（名前の変更、選択を戻す、単語の削除、貼り付け）。
      "f2": null,
      "ctrl-u": null,
      "ctrl-delete": null,
      "shift-insert": null,

      // F8 and F9 do nothing outside debugging, as in VSCode. / F8・F9 は VSCode と同じく、デバッグ中でなければ何もしない。
      "f8": null,
      "f9": null
    }
  },
  {
    // Full-size editors only / 通常のエディターだけ
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-b": "editor::MoveToPreviousWordStart",

      // Code / コード
      "ctrl-.": "editor::ToggleCodeActions",
      "ctrl-x r": "editor::Rename",
      "ctrl-x ctrl-r": "editor::Rename",
      "ctrl-shift-k": "assistant::InlineAssist",

      // Folding / 折りたたみ
      "ctrl-x i": "editor::Fold",
      "ctrl-x p": "editor::UnfoldLines",
      "ctrl-alt-1": "editor::FoldAtLevel_1",
      "ctrl-alt-2": "editor::FoldAtLevel_2",
      "ctrl-alt-3": "editor::FoldAtLevel_3",
      "ctrl-alt-4": "editor::FoldAtLevel_4",
      "ctrl-alt-5": "editor::FoldAtLevel_5",
      "ctrl-alt-6": "editor::FoldAtLevel_6",
      "ctrl-alt-7": "editor::FoldAtLevel_7",

      // Breakpoints and tests. VSCode debugs or runs the test at the cursor; Zed's closest actions are these.
      // ブレークポイントとテスト。VSCode はカーソル位置のテストをデバッグ・実行する。Zed でいちばん近いのがこれ。
      "ctrl-8": "editor::ToggleBreakpoint",
      "ctrl-shift-f9": "debugger::Start",
      "ctrl-shift-f10": "editor::SpawnNearestTask"
    }
  },
  {
    // While the mark is active, movement extends the selection. Keep this after the two blocks above.
    // マーク中は、移動で選択範囲を広げる。上の 2 つのブロックより後ろに置く。
    "context": "Editor && selection_mode",
    "bindings": {
      "ctrl-f": "editor::SelectRight",
      "ctrl-b": "editor::SelectLeft",
      "ctrl-n": "editor::SelectDown",
      "ctrl-p": "editor::SelectUp",
      "right": "editor::SelectRight",
      "left": "editor::SelectLeft",
      "down": "editor::SelectDown",
      "up": "editor::SelectUp",
      "ctrl-a": ["editor::SelectToBeginningOfLine", { "stop_at_soft_wraps": false }],
      "ctrl-e": ["editor::SelectToEndOfLine", { "stop_at_soft_wraps": false }],
      "home": ["editor::SelectToBeginningOfLine", { "stop_at_soft_wraps": false }],
      "end": ["editor::SelectToEndOfLine", { "stop_at_soft_wraps": false }],
      "alt-m": ["editor::SelectToBeginningOfLine", { "stop_at_soft_wraps": false, "stop_at_indent": true }],
      "alt-f": "editor::SelectToNextWordEnd",
      "alt-b": "editor::SelectToPreviousWordStart",
      "alt-right": "editor::SelectToNextWordEnd",
      "alt-left": "editor::SelectToPreviousWordStart",
      "ctrl-v": "editor::SelectPageDown",
      "alt-v": "editor::SelectPageUp",
      "pagedown": "editor::SelectPageDown",
      "pageup": "editor::SelectPageUp",
      "alt-<": "editor::SelectToBeginning",
      "alt->": "editor::SelectToEnd",
      "ctrl-home": "editor::SelectToBeginning",
      "ctrl-end": "editor::SelectToEnd",
      "ctrl-x [": "editor::SelectToBeginning",
      "ctrl-x ]": "editor::SelectToEnd",
      "alt-{": "editor::SelectToStartOfParagraph",
      "alt-}": "editor::SelectToEndOfParagraph",
      "ctrl-up": "editor::SelectToStartOfParagraph",
      "ctrl-down": "editor::SelectToEndOfParagraph",
      "ctrl-s": "buffer_search::Deploy",
      "ctrl-space": "editor::Cancel",
      "ctrl-g": "editor::Cancel"
    }
  },
  {
    // Completion and code action menus. C-n and C-p must stay here, or the Editor bindings above would win over the default menu keys.
    // 補完とコードアクションのメニュー。C-n・C-p はここに残す。消すと、上の Editor の割り当てが既定のメニュー操作に勝ってしまう。
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-n": "editor::ContextMenuNext",
      "ctrl-p": "editor::ContextMenuPrevious",
      "ctrl-g": "editor::Cancel"
    }
  },
  {
    "context": "Editor && showing_signature_help && !showing_completions",
    "bindings": {
      "ctrl-n": "editor::SignatureHelpNext",
      "ctrl-p": "editor::SignatureHelpPrevious"
    }
  },
  {
    // Buffer search / バッファー内の検索
    "context": "BufferSearchBar > Editor",
    "bindings": {
      "ctrl-s": "search::SelectNextMatch",
      "ctrl-r": "search::SelectPreviousMatch",
      "enter": "search::SelectNextMatch",
      "ctrl-g": "buffer_search::Dismiss"
    }
  },
  {
    // Debugger keys follow VSCode: F7 while a session exists, F8, F9 and Shift+F8 while stopped.
    // デバッガーのキーは VSCode に合わせる。F7 はセッション中、F8・F9・Shift+F8 は一時停止中だけ。
    "context": "Workspace && debugger_session",
    "bindings": {
      "f7": "debugger::StepInto"
    }
  },
  {
    "context": "Workspace && debugger_stopped",
    "bindings": {
      "f8": "debugger::StepOver",
      "f9": "debugger::Continue",
      "shift-f8": "debugger::StepOut"
    }
  },
  {
    // The same keys at editor depth, so that they win over the editor's own F8 and Shift+F8.
    // エディターの F8・Shift+F8 に勝つように、エディターの深さでも同じキーを書く。
    "context": "Workspace && debugger_stopped > Editor",
    "bindings": {
      "f8": "debugger::StepOver",
      "f9": "debugger::Continue",
      "shift-f8": "debugger::StepOut"
    }
  },
  {
    // In the git diff view, F7 and Shift+F7 move between changes, as in VSCode's diff editor.
    // git の差分表示では、VSCode の diff エディターと同じく F7・Shift+F7 で変更を移動する。
    "context": "GitDiff > Editor",
    "bindings": {
      "f7": "editor::GoToHunk",
      "shift-f7": "editor::GoToPreviousHunk"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-=": "terminal_panel::Toggle",
      "ctrl-^": "terminal_panel::Toggle",
      "ctrl-y": "terminal::Paste",
      "ctrl-x ctrl-c": "pane::CloseActiveItem",
      // Send C-s and C-j to the shell, which the workspace no longer uses; VSCode also unbinds the Shift+Insert paste. / ワークスペースで使わなくなった C-s・C-j はシェルに送る。Shift+Insert の貼り付けは VSCode でも外している。
      "ctrl-s": ["terminal::SendKeystroke", "ctrl-s"],
      "ctrl-j": ["terminal::SendKeystroke", "ctrl-j"],
      "shift-insert": null,
      // Keep these C-x keys from reaching the workspace while in a terminal. / 端末では、これらの C-x キーをワークスペースに渡さない。
      "ctrl-x ctrl-f": null,
      "ctrl-x ctrl-s": null,
      "ctrl-x ctrl-w": null,
      "ctrl-x s": null
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-alt-left": "pane::GoBack",
      "ctrl-alt-right": "pane::GoForward",
      // VSCode unbinds closing a tab with C-w and moving to the next tab with C-PageDown. / C-w でタブを閉じる操作と C-PageDown で次のタブへ移る操作は、VSCode で外している。
      "ctrl-w": null,
      "ctrl-pagedown": null
    }
  },
  {
    // Project panel. Keep this before the menu block. / プロジェクトパネル。menu のブロックより前に置く。
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious",
      "ctrl-f": "project_panel::ExpandSelectedEntry",
      "ctrl-b": "project_panel::CollapseSelectedEntry",
      "ctrl-v": "menu::SelectLast",
      "alt-v": "menu::SelectFirst",
      "enter": "project_panel::OpenPermanent",
      "ctrl-[": "editor::ToggleFocus",
      "ctrl-w": "project_panel::Cut",
      "alt-w": "project_panel::Copy",
      "ctrl-y": "project_panel::Paste",
      "ctrl-u n": "project_panel::NewFile",
      "ctrl-u ctrl-n": "project_panel::NewFile",
      "ctrl-x ctrl-n": "project_panel::NewFile",
      "ctrl-u f": "project_panel::NewDirectory",
      "ctrl-u ctrl-f": "project_panel::NewDirectory",
      "ctrl-u d": "project_panel::NewDirectory",
      "ctrl-u ctrl-d": "project_panel::NewDirectory",
      "ctrl-u r": "project_panel::Rename",
      "ctrl-u ctrl-r": "project_panel::Rename",
      "ctrl-x d": "project_panel::OpenSplitVertical",
      "ctrl-x ctrl-d": "project_panel::OpenSplitVertical",
      // Renaming and pasting use C-u r and C-y, as in VSCode. / 名前の変更と貼り付けは、VSCode と同じく C-u r と C-y を使う。
      "f2": null,
      "shift-insert": null
    }
  },
  {
    "context": "menu",
    "bindings": {
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious",
      "ctrl-f": "menu::SelectChild",
      "ctrl-b": "menu::SelectParent",
      "ctrl-s": "search::FocusSearch",
      "ctrl-g": "menu::Cancel"
    }
  }
]
