+// Copyright 2026 OfficeCLI (https://OfficeCLI.AI)
+// SPDX-License-Identifier: Apache-2.0
+
+using System.Text;
+
+namespace OfficeCli.Core;
+
+/// <summary>Loads embedded browser bundles. / 埋め込まれた描画資産を読み込む。</summary>
+internal static class BrowserAssets
+{
+    private const string ResourcePrefix = "OfficeCli.Resources.browser-assets.";
+
+    private static readonly Lazy<string> Mermaid = new(() => ReadText("mermaid.js"));
+    private static readonly Lazy<string> Three = new(() => ReadText("three.js"));
+    private static readonly Lazy<string> Katex = new(() => ReadText("katex.js"));
+    private static readonly Lazy<string> KatexCss = new(() => ReadText("katex.css"));
+
+    public static string MermaidJs => Mermaid.Value;
+    public static string ThreeJs => Three.Value;
+    public static string KatexJs => Katex.Value;
+    public static string KatexCssText => KatexCss.Value;
+
+    public static string InlineScript(string script)
+    {
+        // Escape closing tags at the HTML boundary. / HTML に埋め込む際に終了タグをエスケープする。
+        var safe = script.Replace("</script", "<\\/script", StringComparison.OrdinalIgnoreCase);
+        return "<script>" + safe + "</script>";
+    }
+
+    public static string InlineStyle(string css) => "<style>" + css + "</style>";
+
+    private static string ReadText(string fileName)
+    {
+        var resourceName = ResourcePrefix + fileName;
+        var assembly = typeof(BrowserAssets).Assembly;
+        using var stream = assembly.GetManifestResourceStream(resourceName)
+            ?? throw new InvalidOperationException(
+                $"Required embedded browser asset '{fileName}' was not found ({resourceName}).");
+        using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
+        return reader.ReadToEnd();
+    }
+}
