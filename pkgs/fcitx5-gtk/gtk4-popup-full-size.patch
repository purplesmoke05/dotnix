+    // Requested candidate window size. The popover has no child widget, so its
+    // intrinsic measured size is tiny; measure() reports these instead.
+    int width;
+    int height;
 };
 
 G_DEFINE_TYPE(FcitxClientSidePopup, fcitx_client_side_popup, GTK_TYPE_POPOVER)
 
+static void fcitx_client_side_popup_measure(GtkWidget *widget,
+                                            GtkOrientation orientation,
+                                            int /*for_size*/, int *minimum,
+                                            int *natural,
+                                            int *minimum_baseline,
+                                            int *natural_baseline) {
+    auto *self = FCITX_CLIENT_SIDE_POPUP(widget);
+    const int size = orientation == GTK_ORIENTATION_HORIZONTAL ? self->width
+                                                               : self->height;
+    *minimum = MAX(size, 1);
+    *natural = MAX(size, 1);
+    if (minimum_baseline) {
+        *minimum_baseline = -1;
+    }
+    if (natural_baseline) {
+        *natural_baseline = -1;
+    }
+}
+
 static void fcitx_client_side_popup_snapshot(GtkWidget *widget,
                                              GtkSnapshot *snapshot) {
     int width = gtk_widget_get_width(widget);
     int height = gtk_widget_get_height(widget);
 
+    // FIXME: temporary diagnostic for the GTK4 client-side popup sizing bug.
+    // Enable with FCITX5_GTK_DEBUG_POPUP=1 and G_MESSAGES_DEBUG=all.
+    if (g_getenv("FCITX5_GTK_DEBUG_POPUP")) {
+        auto *popup = FCITX_CLIENT_SIDE_POPUP(widget);
+        g_debug("fcitx5-gtk popup: requested=%dx%d allocated=%dx%d",
+                popup->width, popup->height, width, height);
+    }
+
     if (width <= 0 || height <= 0) {
         return;
     }
